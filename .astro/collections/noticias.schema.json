{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "fecha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "autor": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "imagen": {
      "type": "string"
    },
    "extracto": {
      "type": "string"
    },
    "destacado": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "fecha"
  ]
}