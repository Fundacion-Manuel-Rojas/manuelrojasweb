<style>
  .site-header {
    background: #353535;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 20px;
  }
  .site-logo img { width: 200px; height: auto; display: block; }
  .social-icons {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #555;
    color: #ccc;
    transition: background 0.2s, color 0.2s;
  }
  .social-icons a:hover {
    color: #fff;
  }
  .social-icons a.fb:hover { background: #1877F2; }
  .social-icons a.tw:hover { background: #1DA1F2; }
  .social-icons a.vm:hover { background: #1AB7EA; }
  .social-icons svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .site-nav {
    background: #474747;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    position: relative;
    z-index: 20;
  }
  .site-nav > ul {
    display: flex;
    justify-content: center;
    list-style: none;
    gap: 28px;
    flex-wrap: wrap;
  }
  .site-nav a {
    color: #ccc;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    display: block;
  }
  .site-nav > ul > li > a:hover,
  .site-nav .submenu a:hover { color: #fff; }

  .has-submenu { position: relative; }
  .has-submenu > a::after {
    content: ' ▾';
    font-size: 10px;
  }

  .submenu {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #2a2a2a;
    list-style: none;
    padding: 8px 0;
    min-width: 180px;
    border-radius: 0 0 4px 4px;
    z-index: 100;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .has-submenu:hover .submenu { opacity: 1; visibility: visible; }

  .submenu li { text-align: left; }
  .submenu a {
    padding: 6px 16px;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
  }
  .submenu a:hover { background: #444; }

  .has-subsubmenu { position: relative; }
  .has-subsubmenu > a::after {
    content: ' ▸';
    font-size: 10px;
    float: right;
    margin-top: 2px;
  }
  .subsubmenu {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    left: 100%;
    top: 0;
    background: #2a2a2a;
    list-style: none;
    padding: 8px 0;
    min-width: 220px;
    border-radius: 0 4px 4px 0;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .has-subsubmenu:hover .subsubmenu { opacity: 1; visibility: visible; }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: #ccc;
    font-size: 24px;
    cursor: pointer;
    padding: 8px 12px;
    line-height: 1;
  }
  .menu-toggle:hover { color: #fff; }

  @media (max-width: 768px) {
    .site-header {
      padding-right: 12px;
    }
    .site-logo img { width: 150px; }
    .social-icons { gap: 8px; }
    .social-icons a {
      width: 28px;
      height: 28px;
    }
    .social-icons svg {
      width: 14px;
      height: 14px;
    }
    .site-nav {
      position: relative;
      flex-direction: column;
    }
    .site-nav > ul {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      padding: 0;
    }
    .site-nav.open > ul { display: flex; }
    .menu-toggle {
      display: block;
      width: 100%;
      text-align: center;
    }
    .site-nav > ul > li {
      width: 100%;
      text-align: center;
    }
    .site-nav > ul > li > a {
      padding: 12px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .submenu {
      position: static;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      transform: none;
      background: #333;
      border-radius: 0;
      min-width: auto;
      transition: max-height 0.35s ease, opacity 0.35s ease;
    }
    .has-submenu.open > .submenu {
      opacity: 1;
      visibility: visible;
      max-height: 600px;
    }
    .subsubmenu {
      position: static;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      background: #3a3a3a;
      border-radius: 0;
      min-width: auto;
      transition: max-height 0.35s ease, opacity 0.35s ease;
    }
    .has-subsubmenu.open > .subsubmenu {
      opacity: 1;
      visibility: visible;
      max-height: 600px;
    }
    .submenu a, .subsubmenu a {
      padding: 10px 16px;
      display: block;
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .site-logo img { width: 120px; }
    .social-icons a {
      width: 24px;
      height: 24px;
    }
    .social-icons svg {
      width: 12px;
      height: 12px;
    }
    .site-nav > ul > li > a {
      font-size: 13px;
      padding: 8px 12px;
    }
  }
</style>

