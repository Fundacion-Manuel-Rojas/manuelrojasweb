<script>
  const nav = document.getElementById('main-nav');
  const toggle = document.getElementById('menu-toggle');

  function closeAllSubmenus() {
    nav.querySelectorAll('.has-submenu.open, .has-subsubmenu.open').forEach(el => el.classList.remove('open'));
  }

  function closeSiblingSubmenus(li) {
    const parentUl = li.parentElement;
    if (!parentUl) return;
    parentUl.querySelectorAll(':scope > li.open').forEach(el => {
      if (el !== li) el.classList.remove('open');
    });
  }

  function isMobile() { return window.innerWidth <= 768; }

  toggle.addEventListener('click', function(e) {
    e.stopPropagation();
    nav.classList.toggle('open');
    this.setAttribute('aria-label', nav.classList.contains('open') ? 'Cerrar menú' : 'Abrir menú');
  });

  nav.addEventListener('click', function(e) {
    if (!isMobile()) return;
    const link = e.target.closest('a');
    if (!link) return;
    const li = link.parentElement;
    if (li.classList.contains('has-submenu') || li.classList.contains('has-subsubmenu')) {
      e.preventDefault();
      const wasOpen = li.classList.contains('open');
      closeSiblingSubmenus(li);
      if (!wasOpen) li.classList.add('open');
    } else {
      nav.classList.remove('open');
      closeAllSubmenus();
    }
  });

  document.addEventListener('click', function(e) {
    if (!isMobile()) return;
    if (!nav.contains(e.target) && nav.classList.contains('open')) {
      nav.classList.remove('open');
      closeAllSubmenus();
    }
  });

  window.addEventListener('resize', function() {
    if (!isMobile()) {
      nav.classList.remove('open');
      closeAllSubmenus();
    }
  });
</script>
