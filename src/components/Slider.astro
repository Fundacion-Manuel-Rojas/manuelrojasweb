---
import { getCollection } from 'astro:content';
import { marked } from 'marked';

const slides = await getCollection('slider');
const sorted = slides
  .filter(s => s.data.imagen)
  .map(s => ({
    ...s,
    html: s.data.texto ? marked.parse(s.data.texto, { async: false }) : '',
  }))
  .sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0));
---

<style>
  .hero-slider {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
  }
  .hero-slider .slides {
    display: flex;
    height: 100%;
    transition: transform 0.6s ease-in-out;
  }
  .hero-slider .slide {
    min-width: 100%;
    height: 100%;
    position: relative;
  }
  .hero-slider .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-slider .slide a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-slider .slide-overlay {
    position: absolute;
    top: 80%;
    right: 2rem;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.85);
    color: #000000;
    padding: 1rem 1.5rem;
    max-width: 55%;
    text-align: left;
    font-size: 1.05rem;
    line-height: 1.4;
    font-weight: 500;
    border-radius: 0.375rem;
    pointer-events: none;
  }
  .hero-slider .slide-overlay a {
    color: #fff;
    text-decoration: underline;
  }
  .hero-slider .slide-overlay p { margin: 0; }
  .hero-slider .slide-overlay strong { font-weight: 700; }
  .hero-slider .slide-overlay em { font-style: italic; }

  .hero-slider .dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }
  .hero-slider .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    border: none;
    cursor: pointer;
    transition: background 0.3s;
  }
  .hero-slider .dot.active { background: #fff; }

  @media (max-width: 768px) {
    .hero-slider { height: 280px; }
    .hero-slider .dot { width: 10px; height: 10px; }
    .hero-slider .dots { bottom: 8px; gap: 6px; }
    .hero-slider .slide-overlay { font-size: 0.95rem; padding: 0.75rem 1.1rem; right: 1.25rem; max-width: 60%; }
  }
  @media (max-width: 480px) {
    .hero-slider { height: 200px; }
    .hero-slider .dot { width: 8px; height: 8px; }
    .hero-slider .dots { bottom: 8px; gap: 5px; }
    .hero-slider .slide-overlay { font-size: 0.85rem; padding: 0.5rem 0.75rem; right: 0.75rem; max-width: 70%; }
  }
</style>

<div class="hero-slider" id="hero-slider">
  <div class="slides">
    {sorted.map(slide => (
      <div class="slide">
        {slide.data.enlace ? (
          <a target="_blank" href={slide.data.enlace}>
            <img src={slide.data.imagen} alt={slide.data.alt || ''} />
          </a>
        ) : (
          <img src={slide.data.imagen} alt={slide.data.alt || ''} />
        )}
        {slide.html && (
          <div class="slide-overlay" set:html={slide.html} />
        )}
      </div>
    ))}
  </div>

  <div class="dots">
    {sorted.map((_, i) => (
      <button class={`dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Ir a diapositiva ${i + 1}`}></button>
    ))}
  </div>
</div>

<script>
  (function() {
    const slider = document.getElementById('hero-slider');
    if (!slider) return;
    const slidesEl = slider.querySelector('.slides');
    const dots = slider.querySelectorAll('.dot');
    const total = dots.length;
    if (total < 2) {
      slider.querySelectorAll('.dots').forEach(el => el.style.display = 'none');
      return;
    }
    let current = 0;
    let interval: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      current = ((index % total) + total) % total;
      (slidesEl as HTMLElement).style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function next() { goTo(current + 1); }

    dots.forEach(dot => {
      dot.addEventListener('click', () => { goTo(Number((dot as HTMLElement).dataset.index)); resetAuto(); });
    });

    function resetAuto() { clearInterval(interval); interval = setInterval(next, 10000); }
    interval = setInterval(next, 10000);
  })();
</script>
