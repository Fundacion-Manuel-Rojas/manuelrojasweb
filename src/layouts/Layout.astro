---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  ogType?: 'website' | 'article' | 'book' | 'profile';
  noindex?: boolean;
  canonical?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleData?: {
    headline: string;
    description?: string;
    image?: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
    url: string;
  };
  bookData?: {
    name: string;
    description?: string;
    image?: string;
    author?: string;
    datePublished?: number;
    genre?: string;
    inLanguage?: string;
    url: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  image,
  twitterCard = 'summary_large_image',
  ogType = 'website',
  noindex = false,
  canonical,
  publishedTime,
  modifiedTime,
  author,
  articleData,
  bookData,
  breadcrumbs,
} = Astro.props;

const siteUrl = 'https://manuelrojas.cl';
const siteName = 'Fundación Manuel Rojas';
const defaultDescription = 'Fundación Manuel Rojas - Preservando y difundiendo la vida y obra del escritor chileno Manuel Rojas (1896-1973), autor de «Hijo de ladrón».';
const defaultImagePath = '/media/default_noticias.webp';
const defaultImage = `${siteUrl}${defaultImagePath}`;

const rawImage = image || defaultImagePath;
const fullImage = rawImage.startsWith('http') ? rawImage : `${siteUrl}${rawImage.startsWith('/') ? '' : '/'}${rawImage}`;

const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const finalDescription = (description || defaultDescription).slice(0, 160);

const canonicalUrl = canonical
  ? (canonical.startsWith('http') ? canonical : `${siteUrl}${canonical.startsWith('/') ? '' : '/'}${canonical}`)
  : new URL(Astro.url.pathname, siteUrl).href.replace(/\/index\.html$/, '/');
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#5A9AB5" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={finalDescription} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

  <link rel="canonical" href={canonicalUrl} />

  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alice&display=swap" rel="stylesheet" />

  <ClientRouter />

  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={finalDescription} />
  <meta property="og:image" content={fullImage} />
  <meta property="og:image:secure_url" content={fullImage} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:locale:alternate" content="es_ES" />

  {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {ogType === 'article' && author && <meta property="article:author" content={author} />}

  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:site" content="@fundacionmr" />
  <meta name="twitter:creator" content="@fundacionmr" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={finalDescription} />
  <meta name="twitter:image" content={fullImage} />
  <meta name="twitter:image:alt" content={title} />

  <StructuredData
    organization={true}
    article={articleData}
    book={bookData}
    breadcrumbs={breadcrumbs}
  />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Alice', Georgia, 'Times New Roman', serif;
      font-size: 18px;
      color: #666;
      background: #fff url('/media/background.webp') no-repeat fixed center center;
      background-size: cover;
      line-height: 1.7em;
      font-weight: 500;
      -webkit-font-smoothing: antialiased;
    }
    a { color: #5A9AB5; text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; height: auto; }
    #main-content img { max-width: 100%; height: auto; }

    .site-wrapper {
      max-width: 1280px;
      margin: 30px auto;
      background: #fff;
      border-radius: 6px;
      box-shadow: 0 1px 6px rgba(0,0,0,0.08);
      overflow: hidden;
    }

    .inner { width: 80%; max-width: 1080px; margin: auto; position: relative; }

    #main-content { padding-bottom: 40px; }
    .content-wrapper {
      max-width: 1080px;
      margin-left: auto;
      margin-right: auto;
      width: 80%;
    }
    .content-wrapper :global(p) {
      margin-bottom: 1rem;
      line-height: 1.625;
      color: #4b5563;
    }
    .content-wrapper :global(img) {
      max-width: 100%;
      height: auto;
    }
    .content-wrapper :global(h2) {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 1rem;
      margin-top: 2rem;
    }
    .content-wrapper :global(article > p:first-of-type::first-letter) {
      float: left;
      font-size: 3rem;
      font-weight: 700;
      margin-right: 0.5rem;
      line-height: 1.25;
      color: #1f2937;
    }
    .content-wrapper > :global(img),
    .content-wrapper > :global(a) > :global(img) {
      display: block;
      margin-left: auto;
      margin-right: auto;
      max-height: 550px;
      max-width: min(100%, 500px);
      height: auto;
      width: auto;
      object-fit: scale-down;
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .content-wrapper :global(input[type="text"]),
    .content-wrapper :global(input[type="email"]),
    .content-wrapper :global(input[type="tel"]),
    .content-wrapper :global(input[type="number"]),
    .content-wrapper :global(textarea) {
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
      padding: 8px 12px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-family: inherit;
      font-size: 16px;
    }
    .content-wrapper :global(input[type="submit"]) {
      background: #353535;
      color: #fff;
      border: none;
      padding: 10px 24px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
      font-family: inherit;
      transition: background 0.2s;
    }
    .content-wrapper :global(input[type="submit"]:hover) {
      background: #555;
    }

    @media (max-width: 1024px) {
      body { font-size: 17px; }
    }

    @media (max-width: 768px) {
      body {
        font-size: 16px;
        background-attachment: scroll;
      }
      .content-wrapper { width: 94%; padding: 0 8px; }
      .site-wrapper {
        max-width: 100%;
        margin: 0;
        border-radius: 0;
      }
      .inner { width: 90%; }
      .content-wrapper > :global(img),
      .content-wrapper > :global(a) > :global(img) {
        max-height: 400px;
        max-width: min(100%, 400px);
      }
      .content-wrapper :global(h1) { font-size: 1.5rem; }
      .content-wrapper :global(h2) { font-size: 1.25rem; }
      .content-wrapper :global(h3) { font-size: 1.1rem; }
      .content-wrapper :global(table) { font-size: 14px; }
      .content-wrapper :global(table) tbody,
      .content-wrapper :global(table) tr { display: block; }
      .content-wrapper :global(table) tr { height: auto !important; margin-bottom: 1rem; }
      .content-wrapper :global(table) td,
      .content-wrapper :global(table) th {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: 8px;
      }
      .content-wrapper :global(table) td:not(:last-child) {
        margin-bottom: 12px;
      }
      .content-wrapper :global(.first-letter\:text-5xl)::first-letter {
        font-size: 2.5rem;
      }
    }

    @media (max-width: 480px) {
      .content-wrapper { width: 96%; padding: 0 4px; }
      #main-content { padding-bottom: 24px; }
      .content-wrapper > :global(img),
      .content-wrapper > :global(a) > :global(img) {
        max-height: 300px;
        max-width: 100%;
      }
    }

    @media (max-width: 1320px) {
      .site-wrapper {
        margin-left: 20px;
        margin-right: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="site-wrapper">
    <Header />

    <section id="main-content" transition:animate="fade">
      <slot name="full-width" />
      <div class="content-wrapper">
        <slot />
      </div>
    </section>

    <Footer />
  </div>
</body>
</html>
