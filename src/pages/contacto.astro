---
import Layout from '../layouts/Layout.astro';
const title = "Contacto";
---

<Layout title={title}>

<h1 class="text-3xl font-bold text-gray-800 mb-6">CONTACTO</h1>
<div lang="en-US" dir="ltr"><form action="/contacto/#wpcf7-f11329-p10-o1" method="post" novalidate="novalidate"><input type="hidden" name="_wpcf7" value="11329"><input type="hidden" name="_wpcf7_version" value="6.1"><input type="hidden" name="_wpcf7_locale" value="en_US"><input type="hidden" name="_wpcf7_unit_tag" value="wpcf7-f11329-p10-o1"><input type="hidden" name="_wpcf7_container_post" value="10"><input type="hidden" name="_wpcf7_posted_data_hash" value=""><p class="mb-4 leading-relaxed text-gray-600"><label> Su nombre<br><span data-name="your-name"><input size="40" maxlength="400" autocomplete="name" value="" type="text" name="your-name"></span></label></p><p class="mb-4 leading-relaxed text-gray-600"><label> E-mail<br><span data-name="your-email"><input size="40" maxlength="400" autocomplete="email" value="" type="email" name="your-email"></span></label></p><p class="mb-4 leading-relaxed text-gray-600"><label> Asunto<br><span data-name="your-subject"><input size="40" maxlength="400" value="" type="text" name="your-subject"></span></label></p><p class="mb-4 leading-relaxed text-gray-600"><label> Mensaje<br><span data-name="your-message"><textarea cols="40" rows="10" maxlength="2000" name="your-message"></textarea></span></label></p><p class="mb-4 leading-relaxed text-gray-600"><input type="submit" value="Enviar"></p></form></div>

</Layout>