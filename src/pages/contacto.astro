---
import Layout from '../layouts/Layout.astro';
const title = "Contacto";
---

<Layout title={title}>

  <h1 class="text-3xl font-bold text-gray-800 my-12">CONTACTO</h1>

  <!-- 
    Netlify Forms: 
    - data-netlify="true" le dice a Netlify que capture este formulario.
    - El campo hidden "form-name" es obligatorio para que Netlify lo identifique.
    - En tu dashboard de Netlify (Sitio > Forms) configura una notificación por email a: fe.manuelrojas@gmail.com
  -->
  <form 
    name="contacto" 
    method="POST" 
    data-netlify="true"
    action="/contacto/"
    class="max-w-xl"
  >
    <input type="hidden" name="form-name" value="contacto" />

    <div class="mb-6">
      <label for="email" class="block text-md font-medium text-gray-700 mb-2">Correo electrónico</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        class="w-full border border-gray-300 rounded-md p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:border-transparent"
      />
    </div>

    <div class="mb-6">
      <label for="mensaje" class="block text-md font-medium text-gray-700 mb-2">Mensaje</label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="8"
        maxlength="2000"
        required
        class="w-full border border-gray-300 rounded-md p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:border-transparent"
      ></textarea>
    </div>

    <button
      type="submit"
      class="bg-gray-800 text-white px-6 py-2 rounded-md hover:bg-gray-700 transition-colors cursor-pointer"
    >
      Enviar
    </button>
  </form>

</Layout>
