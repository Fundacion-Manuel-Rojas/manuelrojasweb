---
import Layout from '../layouts/Layout.astro';
import Slider from '../components/Slider.astro';
import { getCollection } from 'astro:content';

const title = "Fundación Manuel Rojas";

const todasNoticias = await getCollection('noticias');
const noticiasDestacadas = todasNoticias
  .filter(n => n.data.destacado === true)
  .sort((a, b) => {
    const dateA = a.data.fecha ? new Date(a.data.fecha).getTime() : 0;
    const dateB = b.data.fecha ? new Date(b.data.fecha).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 3);
---

<Layout title={title}>
  <Slider slot="full-width" />

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 mt-12">
    <a href="/manuel-rojas/vida/biografia/"
      class="group flex flex-col bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 hover:border-blue-200 h-full"
    >
      <h3 class="text-xl font-bold text-gray-800 text-center py-4 group-hover:text-blue-500 transition-colors leading-snug">
        Biografía
      </h3>
      <div class="aspect-[3/4] w-full overflow-hidden bg-gray-100">
        <img
          src="/media/fotografias/14-Manuel-Rojas-Retrato-1966-669x1024-1.webp"
          alt="Biografía de Manuel Rojas"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
      <div class="p-4 flex-1">
        <p class="text-md text-gray-500 leading-relaxed line-clamp-3">
          Manuel Rojas (Buenos Aires, 1896 – Santiago, 1973) es reconocido como uno de los autores más notables de la literatura chilena. Su obra más difundida, «Hijo de ladrón», se considera como la mejor novela chilena del siglo XX…
        </p>
      </div>
    </a>

    <a href="/manuel-rojas/obra/novelas/"
      class="group flex flex-col bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 hover:border-blue-200 h-full"
    >
      <h3 class="text-xl font-bold text-gray-800 text-center py-4 group-hover:text-blue-500 transition-colors leading-snug">
        Obra
      </h3>
      <div class="aspect-[3/4] w-full overflow-hidden bg-gray-100">
        <img
          src="/media/2024/11/Manuel-Rojas-Cuentos.webp"
          alt="Obra de Manuel Rojas"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
      <div class="p-4 flex-1">
        <p class="text-md text-gray-500 leading-relaxed line-clamp-3">
Desde el relato breve, Manuel Rojas transita a la novela como un paso natural y lógico, donde el material literario proviene mayoritariamente de las experiencias de su propia vida. 
        </p>
      </div>
    </a>

    <a href="/manuel-rojas/galeria/fotografias/"
      class="group flex flex-col bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 hover:border-blue-200 h-full"
    >
      <h3 class="text-xl font-bold text-gray-800 text-center py-4 group-hover:text-blue-500 transition-colors leading-snug">
        Galería
      </h3>
      <div class="aspect-[3/4] w-full overflow-hidden bg-gray-100">
        <img
          src="/media/fotografias/slide1.webp"
          alt="Galería de Manuel Rojas"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
      <div class="p-4 flex-1">
        <p class="text-md text-gray-500 leading-relaxed line-clamp-3">
          Fotografías, audios y otros materiales que documentan la vida y obra de Manuel Rojas…
        </p>
      </div>
    </a>
  </div>


  {
    noticiasDestacadas.length > 0 && (
      <>
        <h2 class="text-2xl font-bold text-gray-800 mb-4 mt-8">Noticias</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          {noticiasDestacadas.map((noticia) => (
            <a target="_blank" href={`/noticias/${noticia.id}/`}
              class="group block bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 hover:border-blue-200"
            >
              {noticia.data.imagen ? (
                <div class="aspect-[16/10] overflow-hidden bg-gray-100">
                  <img
                    src={noticia.data.imagen}
                    alt={noticia.data.subtitle || noticia.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="aspect-[16/10] bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                  <span class="text-4xl text-gray-300 font-serif">
                    {noticia.data.subtitle?.charAt(0) || noticia.data.title?.charAt(0) || 'N'}
                  </span>
                </div>
              )}
              <div class="p-4">
                <p class="text-md text-gray-400 mb-2">
                  {noticia.data.fecha
                    ? new Date(noticia.data.fecha).toLocaleDateString('es-CL', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })
                    : ''}
                </p>
                <h3 class="text-base font-bold text-gray-800 mb-2 group-hover:text-blue-500 transition-colors leading-snug">
                  {noticia.data.subtitle || noticia.data.title}
                </h3>
                {noticia.data.extracto && (
                  <p class="text-md text-gray-500 leading-relaxed line-clamp-3">
                    {noticia.data.extracto}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      </>
    )
  }


  
</Layout>
