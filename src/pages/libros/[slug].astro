---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const libros = await getCollection('libros');
  return libros.map((libro) => ({
    params: { slug: libro.id },
    props: { libro },
  }));
}

const { libro } = Astro.props;
const { Content } = await render(libro);

const categoriaLabels = {
  poesia: 'Poesía',
  novela: 'Novelas',
  cuento: 'Cuentos',
  ensayo: 'Ensayos',
  autobiografia_viaje: 'Memorias & Viajes',
  compilacion: 'Compilaciones',
};

const categoriaLabel = categoriaLabels[libro.data.categoria] || libro.data.categoria;

const categoriaSlugMap: Record<string, string> = {
  poesia: 'poesia',
  novela: 'novelas',
  cuento: 'cuentos-libro',
  ensayo: 'ensayos-2',
  autobiografia_viaje: 'autobiografias_viajes',
  compilacion: 'compilaciones',
};

const categoriaSlug = categoriaSlugMap[libro.data.categoria] || libro.data.categoria;

const generoMap: Record<string, string> = {
  poesia: 'Poesía',
  novela: 'Novela',
  cuento: 'Cuento',
  ensayo: 'Ensayo',
  autobiografia_viaje: 'Autobiografía',
  compilacion: 'Compilación',
};

const allImages = [
  libro.data.imagen ? { src: libro.data.imagen, link: libro.data.imagen_link } : null,
  ...(libro.data.imagenes?.map((img: any) => typeof img === 'string' ? { src: img, link: null } : img) || [])
].filter(Boolean);

const slugPath = `/libros/${libro.id}/`;
const ediciones = libro.data.ediciones || [];
const firstEdition = ediciones.length > 0 ? ediciones.reduce((a, b) => (a.anio < b.anio ? a : b)) : null;
const description = `${libro.data.titulo}, de Manuel Rojas. ${categoriaLabel}. ${firstEdition ? `Primera edición: ${firstEdition.editorial}, ${firstEdition.anio}.` : ''}`.trim();
---

<Layout
  title={libro.data.titulo}
  description={description}
  image={libro.data.imagen}
  ogType="book"
  bookData={{
    name: libro.data.titulo,
    description,
    image: libro.data.imagen,
    author: 'Manuel Rojas',
    datePublished: firstEdition?.anio,
    genre: generoMap[libro.data.categoria],
    inLanguage: 'es-CL',
    url: slugPath,
  }}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Manuel Rojas', url: '/manuel-rojas/' },
    { name: categoriaLabel, url: `/manuel-rojas/obra/${categoriaSlug}/` },
    { name: libro.data.titulo, url: slugPath },
  ]}
>
  <h3 class="text-lg text-gray-400 mb-6 pt-6 pb-3 border-b border-gray-200">
    <span class="text-gray-500">Obra /</span>
    <a target="_blank" href={`/manuel-rojas/obra/${categoriaSlug}/`} class="text-blue-500 hover:underline">{categoriaLabel}</a>
    / {libro.data.titulo}
  </h3>

  {allImages.length > 0 && (
    <div class="obra-images flex gap-4 flex-wrap justify-center">
      {allImages.map((img: any) => (
        img.link ? (
          <a href={img.link} target="_blank" rel="noopener" class="flex-shrink-0">
            <img src={img.src} alt="" title={libro.data.titulo} class="rounded-lg border border-gray-300 shadow-sm max-w-full h-auto my-4 mx-auto block">
          </a>
        ) : (
          <div class="flex-shrink-0">
            <img src={img.src} alt="" title={libro.data.titulo} class="rounded-lg border border-gray-300 shadow-sm max-w-full h-auto my-4 mx-auto block">
          </div>
        )
      ))}
    </div>
  )}

  {ediciones.length > 0 && (
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-800 mb-3">Ediciones</h2>
      <ul class="list-disc pl-5 mb-4 leading-relaxed text-gray-600">
        {ediciones.map((edicion) => (
          <li>
            <strong>{edicion.nombre}:</strong> {edicion.editorial}{edicion.lugar && ` – ${edicion.lugar}`}, {edicion.anio}
            {edicion.url && (
              <> — <a href={edicion.url} target="_blank" rel="noopener" class="text-blue-500 hover:underline">ver más</a></>
            )}
          </li>
        ))}
      </ul>
    </div>
  )}

  {libro.data.pdf && (
    <p class="mb-4 leading-relaxed text-gray-600">
      <a href={libro.data.pdf} target="_blank" rel="noopener" class="text-blue-500 hover:underline">Descargar PDF</a>
    </p>
  )}

  {libro.data.enlaces?.map((enlace: { titulo: string; url: string }) => (
    <p class="mb-4 leading-relaxed text-gray-600">
      <a href={enlace.url} target="_blank" rel="noopener" class="text-blue-500 hover:underline">{enlace.titulo}</a>
    </p>
  ))}

  <Content />

  {libro.data.traducciones && libro.data.traducciones.length > 0 && (
    <>
      <h2 class="text-2xl font-bold text-gray-800 mb-4 mt-8">Traducciones</h2>
      <table class="w-full border-collapse mb-6 text-sm">
        <tbody>
          {libro.data.traducciones.map((trad: { titulo: string; idioma: string; lugar: string; anio?: number; imagen?: string }) => (
            <tr>
              <td class="border border-gray-200 p-3 align-top">
                {trad.imagen && <img src={trad.imagen} alt="" class="rounded-lg border border-gray-300 shadow-sm max-w-full h-auto my-4 mx-auto block" style="float: right;">}
              </td>
              <td class="border border-gray-200 p-3 align-top">
                <h5 class="text-base font-semibold text-gray-700 mb-2">{trad.titulo} – {trad.lugar}{trad.anio && `, ${trad.anio}`}</h5>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}
</Layout>
