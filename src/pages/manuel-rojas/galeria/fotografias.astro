---
import Layout from '../../../layouts/Layout.astro';

const slides = [
  { img: '/media/fotografias/slide1.jpg', caption: 'Manuel Rojas - Retrato. Mendoza - Argentina, 1921' },
  { img: '/media/fotografias/slide2_1-1000x1200.jpg', caption: 'Manuel Rojas (al centro) junto a dos actores chilenos. Rancagua - Chile, 1918' },
  { img: '/media/fotografias/slide3.jpg', caption: 'Manuel Rojas - Retratado por Georges Sauré. Santiago de Chile, 1925' },
  { img: '/media/fotografias/slide4.jpg', caption: 'María Baeza y Manuel Rojas. Santiago de Chile, 1928' },
  { img: '/media/fotografias/E5-Manuel-Rojas-Retrato-1934-900x600-b579686ec3-1.jpg', caption: 'Manuel Rojas con su primera hija María Eugenia. Los Andes - Chile, 1932' },
  { img: '/media/fotografias/F6-Manuel-Rojas-Retrato-1937-900x600-0ed402219b.jpg', caption: 'Manuel Rojas (al centro) junto a un grupo de amigos. Cumbre del Cerro Purgatorio, Cordillera de Los Andes - Chile, 1935' },
  { img: '/media/fotografias/slide7.jpg', caption: 'María Eugenia Rojas, María Baeza, Paz Rojas, Patricio Rojas y Manuel Rojas. Santiago de Chile, 1936' },
  { img: '/media/fotografias/G7-Manuel-Rojas-Retrato-1938-370bd4f5b9.jpg', caption: 'Manuel Rojas - Retrato. El Quisco - Chile, 1938' },
  { img: '/media/fotografias/H8-Manuel-Rojas-Retrato-1943-900x600-986f87752e.jpg', caption: 'Manuel Rojas y Valérie López. Atrás, los hijos: María Eugenia Rojas, Patricio Rojas y Paz Rojas. Ester Edwards, madre de Valérie. 1942' },
  { img: '/media/fotografias/I9-Manuel-Rojas-Retrato-1944-900x600-77174c79bb.jpg', caption: 'Manuel Rojas - Retratado por Marcos Chamudes. Santiago de Chile, 1951' },
  { img: '/media/fotografias/J10-Manuel-Rojas-Retrato-1957-900x600-3a4f780f6b.jpg', caption: 'Manuel Rojas recibe el Premio Nacional de Literatura de manos del Min. de Educación, M. Quintana. Santiago de Chile, 1957' },
  { img: '/media/fotografias/K11-Manuel-Rojas-Retrato-195X-900x600-7687a8fc6f.jpg', caption: 'Enrique Espinoza (Samuel Glusberg), Manuel Rojas y Sergio Atria; integrantes del grupo Babel. Santiago de Chile, 1957' },
  { img: '/media/fotografias/K12_manuel_rojas_retrato_1958-7e6524e73d.jpg', caption: 'Manuel Rojas e Isidora Aguirre. Concepción - Chile, 1958' },
  { img: '/media/fotografias/L13-Manuel-Rojas-Retrato-195X-900x600-55eadb30f2.jpg', caption: 'Manuel Rojas, Dr. Hernán San Martín, Pablo Neruda, Fernando Alegría y Gonzalo Rojas. Talcahuano - Chile, 1959' },
  { img: '/media/fotografias/N15-Manuel-Rojas-Retrato-1964-900x600-69241a8f72.jpg', caption: 'Manuel Rojas (al centro) y un grupo de profesores y estudiantes. La Habana - Cuba, 1961' },
  { img: '/media/fotografias/14-Manuel-Rojas-Retrato-1966-669x1024-1.jpg', caption: 'Manuel Rojas - Retrato. Seattle - Estados Unidos, 1963' },
  { img: '/media/fotografias/O16-Manuel-Rojas-Retrato-1965-900x600-88e6f429fb.jpg', caption: 'Manuel Rojas, Julianne Clark, Mercedes Valdivieso y Jaime Valdivieso. Sewell - Chile, 1964' },
  { img: '/media/fotografias/O17-Manuel-Rojas-Retrato_1965-4eb85c50ce.jpg', caption: 'Manuel Rojas, Padre Alfonso Escudero y Carlos Droguett. Santiago de Chile, 1965' },
  { img: '/media/fotografias/P17-Manuel-Rojas-Retrato-1970-900x600-de76ac3cdc.jpg', caption: 'Salvador Allende, Julianne Clark y Manuel Rojas. Santiago de Chile, 1966' },
  { img: '/media/fotografias/P18-Manuel-Rojas-Retrato-1966-85e5f7d7e8.jpg', caption: 'Manuel Rojas - Retrato. Kiev - Ucrania, 1966' },
  { img: '/media/fotografias/18_1-Manuel-Rojas-Retrato-1966.jpg', caption: 'Juan García Ponce, Mario Benedetti, Manuel Rojas y Alejo Carpentier, La Habana, 1967' },
  { img: '/media/fotografias/Q19_manuel_rojas_retrato_1970-f15bfdada8.jpg', caption: 'Manuel Rojas y Juan Carlos Onetti. Chile, 1970' },
  { img: '/media/fotografias/Q20-Manuel-Rojas-Retrato-1971-548f82849d.jpg', caption: 'Francisco Coloane y Manuel Rojas. Trinidad - Cuba, 1971' },
  { img: '/media/fotografias/R19-Manuel-Rojas-Retrato-1971-900x600-a2af8da699.jpg', caption: 'Manuel Rojas - Retrato. Buenos Aires - Argentina, 1972' },
];

const title = "Fotografías";
---

<Layout title={title}>

  <style>
    .foto-slider {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: #111;
    }
    .foto-slider .slides {
      display: flex;
      transition: transform 0.5s ease-in-out;
    }
    .foto-slider .slide {
      min-width: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .foto-slider .slide img {
      width: 100%;
      max-height: 80vh;
      object-fit: contain;
      display: block;
    }
    .foto-slider .arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(0,0,0,0.35);
      color: #fff;
      border: none;
      font-size: 32px;
      padding: 12px 18px;
      cursor: pointer;
      z-index: 10;
      line-height: 1;
      transition: background 0.2s;
      border-radius: 3px;
    }
    .foto-slider .arrow:hover { background: rgba(0,0,0,0.65); }
    .foto-slider .arrow.prev { left: 16px; }
    .foto-slider .arrow.next { right: 16px; }

    .foto-slider .caption {
      width: 100%;
      background: rgba(0,0,0,0.6);
      color: #ccc;
      text-align: center;
      padding: 12px 20px;
      font-size: 14px;
    }

    .foto-slider .dots {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
      z-index: 10;
    }
    .foto-slider .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255,255,255,0.4);
      border: none;
      cursor: pointer;
      transition: background 0.3s;
      padding: 0;
    }
    .foto-slider .dot.active { background: #fff; }

    .foto-slider .counter {
      position: absolute;
      top: 16px;
      right: 20px;
      color: rgba(255,255,255,0.7);
      font-size: 13px;
      z-index: 10;
      background: rgba(0,0,0,0.4);
      padding: 4px 10px;
      border-radius: 3px;
    }

    @media (max-width: 768px) {
      .foto-slider .arrow { font-size: 24px; padding: 8px 12px; }
      .foto-slider .arrow.prev { left: 8px; }
      .foto-slider .arrow.next { right: 8px; }
      .foto-slider .caption { font-size: 12px; padding: 8px 14px; }
      .foto-slider .dots { bottom: 34px; gap: 6px; }
      .foto-slider .dot { width: 8px; height: 8px; }
      .foto-slider .counter { font-size: 11px; top: 10px; right: 12px; }
    }
    @media (max-width: 480px) {
      .foto-slider .slide img { max-height: 60vh; }
      .foto-slider .arrow { font-size: 20px; padding: 6px 10px; }
    }
  </style>

  <div class="foto-slider" id="foto-slider">
    <div class="slides">
      {slides.map(slide => (
        <div class="slide">
          <img src={slide.img} alt={slide.caption} loading="lazy" />
          <div class="caption">{slide.caption}</div>
        </div>
      ))}
    </div>

    <button class="arrow prev" aria-label="Anterior">&#10094;</button>
    <button class="arrow next" aria-label="Siguiente">&#10095;</button>

    <div class="counter" id="foto-counter">1 / {slides.length}</div>

    <div class="dots">
      {slides.map((_, i) => (
        <button class={`dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Ir a diapositiva ${i + 1}`}></button>
      ))}
    </div>
  </div>

  <script>
    (function() {
      const slider = document.getElementById('foto-slider');
      if (!slider) return;
      const slidesEl = slider.querySelector('.slides');
      const dots = slider.querySelectorAll('.dot');
      const counter = document.getElementById('foto-counter');
      const prevBtn = slider.querySelector('.arrow.prev');
      const nextBtn = slider.querySelector('.arrow.next');
      const total = dots.length;
      if (total < 2) {
        slider.querySelectorAll('.arrow, .dots, .counter').forEach(el => el.style.display = 'none');
        return;
      }
      let current = 0;
      let interval;

      function goTo(index) {
        current = ((index % total) + total) % total;
        slidesEl.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
        if (counter) counter.textContent = `${current + 1} / ${total}`;
      }

      function next() { goTo(current + 1); }
      function prev() { goTo(current - 1); }
      function resetAuto() { clearInterval(interval); interval = setInterval(next, 5000); }

      nextBtn?.addEventListener('click', () => { next(); resetAuto(); });
      prevBtn?.addEventListener('click', () => { prev(); resetAuto(); });
      dots.forEach(dot => {
        dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); resetAuto(); });
      });

      let touchStartX = 0;
      slider.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; });
      slider.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) { diff > 0 ? next() : prev(); resetAuto(); }
      });

      interval = setInterval(next, 5000);
    })();
  </script>

</Layout>
