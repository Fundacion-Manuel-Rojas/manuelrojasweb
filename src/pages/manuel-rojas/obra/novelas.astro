---
import Layout from '../../../layouts/Layout.astro';
import BookGallery from '../../../components/BookGallery.astro';
const title = "Novelas";
const books = [
  { href: '/libros/lanchas-en-la-bahia/', img: '/media/2023/06/manuelrojaslanchasenlabahia55.webp', title: 'Lanchas en la bahía' },
  { href: '/manuel-rojas/obra/la-ciudad-de-los-cesares/', img: '/media/2023/06/manuelrojaslaciudaddeloscesares193632.webp', title: 'La Ciudad de los Césares' },
  { href: '/libros/hijo-de-ladron/', img: '/media/2023/06/1361657809_magicfields_imagen_portada_traduccion_1_1.webp', title: 'Hijo de ladrón' },
  { href: '/libros/mejor-que-el-vino/', img: '/media/2023/06/manuelrojasmejorqueelvino42.webp', title: 'Mejor que el vino' },
  { href: '/libros/punta-de-rieles/', img: '/media/2023/06/manuelrojaspuntaderieles13.webp', title: 'Punta de rieles' },
  { href: '/libros/sombras-contra-el-muro/', img: '/media/2023/06/manuelrojassombrascontraelmuro58.webp', title: 'Sombras contra el muro' },
  { href: '/libros/la-oscura-vida-radiante/', img: '/media/2023/06/manuelrojaslaoscuravidaradiante35.webp', title: 'La oscura vida radiante' },
  { href: '/manuel-rojas/obra/tiempo-irremediable/', img: '/media/2023/06/Manuel-Rojas-Tiempo-irremediable-1.webp', title: 'Tiempo irremediable' },
];
---

<Layout title={title}>

  <h3 class="text-lg text-gray-400 mb-6 pt-6 pb-3 border-b border-gray-200"><span class="text-gray-500">Obra /</span> Novelas</h3>

  <p class="mb-4 leading-relaxed text-gray-600 first-letter:float-left first-letter:text-5xl first-letter:font-bold first-letter:mr-2 first-letter:leading-tight first-letter:text-gray-800"><i>«Escribí poesías, porque un amigo me animó a que lo hiciera; cuentista, porque quise ganar, estando en muy mala situación económica, un premio en un concurso; novelista, porque ya no podía detenerme»</i>. Desde el relato breve, Manuel Rojas transita a la novela como un paso natural y lógico, donde el material literario proviene mayoritariamente de las experiencias de su propia vida. Primero en <i>Lanchas en la bahía</i>, luego en <i>La ciudad de los Césares</i> y por último en la serie que tiene como protagonista a <i>Aniceto Hevia</i>, compuesta por cuatro novelas: <i>Hijo de ladrón</i>, <i>Mejor que el vino</i>, <i>Sombras contra el muro</i> y <i>La oscura vida radiante</i>.</p>

  <p class="mb-4 leading-relaxed text-gray-600">Completan la producción novelística de Manuel Rojas, <i>Punta de rieles</i> -novela de tesis sobre los fracasos amorosos-, y la póstuma <i>Tiempo irremediable</i> que recoge su tetralogía en orden cronológico.</p>

  <BookGallery books={books} />

</Layout>
