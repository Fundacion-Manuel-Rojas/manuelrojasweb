---
import Layout from '../../layouts/Layout.astro';
const title = "Miembros";
---

<Layout title={title}>

  <h3 class="text-lg text-gray-400 mb-6 pt-6 pb-3 border-b border-gray-200"><span class="text-gray-500">Quiénes Somos /</span> Integrantes</h3>

  <img src="/media/2023/06/ManuelRojasfamilia.webp" alt="Manuel Rojas y su familia" class="rounded-lg border border-gray-300 shadow-sm w-full h-auto my-6 mx-auto block" />

  <p class="mb-6 leading-relaxed text-gray-600 first-letter:float-left first-letter:text-5xl first-letter:font-bold first-letter:mr-2 first-letter:leading-tight first-letter:text-gray-800">
    La Fundación Manuel Rojas está conformada por familiares del escritor y un grupo de destacados profesionales y académicos comprometidos con la preservación y difusión de su legado literario.
  </p>

  <hr class="border-t border-gray-200 my-8" />

  <h3 class="text-2xl font-semibold text-gray-700 mb-3 mt-8">Fundadores</h3>
  <p class="mb-4 leading-relaxed text-gray-600">Los fundadores son los hijos y nietos de Manuel Rojas:</p>
  <ul class="list-disc pl-6 mb-4 space-y-1 text-gray-600">
    <li>María Eugenia Rojas, Patricio Rojas y Paz Rojas</li>
    <li>Estela Ortiz, María Luisa Ortiz, Mauricio Muñoz y Daniel Muñoz</li>
  </ul>

  <h3 class="text-2xl font-semibold text-gray-700 mb-3 mt-8">Directorio (2015-2018)</h3>
  <ul class="list-disc pl-6 mb-4 space-y-1 text-gray-600">
    <li>Jorge Guerra Carreño — <strong>Presidente</strong> / Arquitecto</li>
    <li>Daniel Muñoz Rojas — <strong>Coordinador</strong> / Psicólogo Social</li>
    <li>Ignacio Álvarez — Dr. en Literatura</li>
    <li>Andrea Palet — Editora</li>
    <li>Gabriel Romero — Profesor</li>
    <li>Pedro Pablo Guerrero — Periodista</li>
    <li>Darío Cortés — Dr. en Literatura</li>
  </ul>

</Layout>
